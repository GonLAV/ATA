# QA Copilot Environment Configuration

# ------------------------------------------------------------------
# LLM / AI Settings
# ------------------------------------------------------------------
# OpenAI API key (required for test generation).
# You may also point this at any OpenAI-compatible endpoint
# (e.g. Azure OpenAI, Ollama, LM Studio) by setting OPENAI_BASE_URL.
OPENAI_API_KEY=sk-...

# Optional: override the default OpenAI base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use for test-scenario generation & bug analysis
OPENAI_MODEL=gpt-4o-mini

# Dynamic discovery/scenario generation limits
DISCOVERY_PAGE_LIMIT=4
MAX_SCENARIOS=12

# Keep false in production to reduce SSRF risk. Enable only for trusted local testing.
ALLOW_PRIVATE_TARGETS=false

# ------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------
PORT=3000

# Optional API key for protecting /api routes. Use a long random value in production.
# Requests may provide it as x-qa-copilot-api-key or Authorization: Bearer <key>.
# QA_COPILOT_API_KEY=change-me-to-a-long-random-value

# Enable structured HTTP request logging. Defaults to false in tests.
LOG_HTTP_REQUESTS=true

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Path to the SQLite database file (created automatically on first run)
DATABASE_PATH=./qa_copilot.db

# ------------------------------------------------------------------
# Screenshots
# ------------------------------------------------------------------
# Directory where screenshots are stored
SCREENSHOTS_DIR=./screenshots

# ------------------------------------------------------------------
# Browser
# ------------------------------------------------------------------
# Set to "true" to run Playwright in headed mode (useful for debugging)
HEADLESS=true

# Viewport dimensions
BROWSER_WIDTH=1280
BROWSER_HEIGHT=800

# Per-action timeout in milliseconds
STEP_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# Autonomous Release Gate
# ------------------------------------------------------------------
# CI/CD release decision thresholds
RELEASE_GATE_MIN_RISK_SCORE=75
RELEASE_GATE_MAX_HIGH_SEVERITY_BUGS=0
RELEASE_GATE_MAX_HIGH_SEVERITY_RISKS=2
RELEASE_GATE_MAX_FAILED_SCENARIO_RATE=0.25
